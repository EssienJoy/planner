# Copy this file to `config.env` (that exact name — server.js loads it)
# and fill in your real secrets. Never commit config.env.
# Run all server commands from inside the server/ folder.

NODE_ENV=development
PORT=3000

# MongoDB Atlas: keep the literal <PASSWORD> placeholder —
# server.js replaces it with DATABASE_PASSWORD at startup.
DATABASE_PASSWORD=your_mongodb_user_password
DATABASE_URI=mongodb+srv://<DB_USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# Auth: long random string for signing JWT session cookies.
JWT_SECRET=your_long_random_secret_at_least_32_characters
JWT_EXPIRES=90d
JWT_COOKIE_EXPIRES_IN=90

# Frontend base URL, used for links inside emails (verification, etc.).
# No trailing slash.
CLIENT_URL=http://localhost:5173

# SMTP provider for transactional mail. Brevo example values below
# (host smtp-relay.brevo.com, port 587, user = your Brevo login email,
# pass = an SMTP key from SMTP & API -> SMTP Keys, NOT your password).
# For local testing, Mailtrap works too (host sandbox.smtp.mailtrap.io).
# IMPORTANT: EMAIL_FROM must be a verified sender in your provider,
# otherwise delivery is rejected.
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_key_or_password
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_FROM=you@example.com

# Groq (AI planner chatbot). Create a key at https://console.groq.com
# under API Keys. Server side only — never expose it to the browser.
GROQ_API_KEY=your_groq_api_key
# Optional model override (default: openai/gpt-oss-120b).
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary (profile photo uploads). Find all three on your
# Cloudinary Dashboard (https://console.cloudinary.com). Never expose
# the API secret to the browser — server side only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
