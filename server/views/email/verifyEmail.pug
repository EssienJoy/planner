extends baseEmail

block content
  p Hi #{firstName},
  p Welcome to Planners, we're glad to have you 🎉
  p Please verify your email address to get started — this link expires in 24 hours.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Verify my email
  p If you didn't create a Planner account, please ignore this email.
